# Research Platform Environment Variables
# Copy this file to .env and update non-secret local settings. Provider keys
# are optional and may instead be exported or stored in ~/.env.

# Environment Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
# Explicit local-only auth bypass. Keep false unless intentionally testing an
# anonymous WebSocket client; ENVIRONMENT=development alone never bypasses auth.
DEV_ALLOW_ANONYMOUS_WEBSOCKETS=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
SECRET_KEY=development-only-secret-key-32-chars

# Database Configuration
DATABASE_URL=postgresql+asyncpg://research:research123@localhost:5432/research_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=research_db
DB_USER=research
DB_PASSWORD=research123

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Temporal Configuration
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_PORT=7233

# Provider API Configuration (optional; fixture mode requires none)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_MODEL=gemini-pro

# MASR routing. MASR_ENABLE_ADAPTIVE is the older strategy heuristic only.
# The Thompson-sampling allocator ships disabled pending held-out evaluation.
MASR_ENABLE_ADAPTIVE=true
ADAPTIVE_ROUTING_ENABLED=false
MEMORY_INFORMED_ROUTING_ENABLED=false
ADAPTIVE_ROUTING_SCHEMA_VERSION=1
ADAPTIVE_ROUTING_POLICY_VERSION=masr-adaptive-v1
# JSON object mapping evaluator names to allowed version lists.
ADAPTIVE_ROUTING_ALLOWED_EVALUATORS={}

# MCP Configuration
MCP_PORT=9000
MCP_TOOLS_ENABLED=true
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=9000

# Monitoring Configuration
ENABLE_METRICS=true
ENABLE_TRACING=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Feature Flags
ENABLE_CACHE=true
ENABLE_RATE_LIMITING=false
MAX_REQUESTS_PER_MINUTE=100

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# JWT Configuration (RS256; no shared JWT secret is consumed)
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_PRIVATE_KEY_PATH=/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/secrets/jwt_public.pem

# Worker Configuration
WORKER_CONCURRENCY=10
TASK_TIMEOUT_SECONDS=300

# Instance Information (for production)
INSTANCE_ID=dev-instance
REGION=local
AVAILABILITY_ZONE=local

# Secrets Provider (env, vault, aws_secrets)
SECRETS_PROVIDER=env

# Alert Configuration (optional)
ALERT_WEBHOOK_URL=
ALERT_EMAIL=

# Validation
VALIDATE_ENV_VARS=false
